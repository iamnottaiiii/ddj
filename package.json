{
  "name": "luma-browser",
  "version": "0.1.0",
  "description": "A private, standalone AI browser for Windows.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "dev": "concurrently -k \"npm:dev:web\" \"wait-on http://127.0.0.1:5173 && cross-env LUMA_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:dir": "npm run build && electron-builder --dir",
    "test": "node --test tests/*.test.mjs"
  },
  "build": {
    "appId": "app.luma.browser",
    "productName": "Luma",
    "artifactName": "Luma-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luma"
    },
    "npmRebuild": false,
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}",
      "requestExecutionLevel": "asInvoker"
    }
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.2"
  },
  "author": "Luma"
}
